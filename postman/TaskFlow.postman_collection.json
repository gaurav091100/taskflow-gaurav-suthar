{
  "info": {
    "name": "TaskFlow (Mock API)",
    "description": "REST contract for the TaskFlow frontend. Base URL: http://localhost:4000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth / Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"New User\",\n  \"email\": \"new@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Auth / Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Projects / List",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/projects"
      }
    },
    {
      "name": "Projects / Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"New Project\",\n  \"description\": \"Optional\"\n}"
        },
        "url": "{{baseUrl}}/projects"
      }
    },
    {
      "name": "Projects / Get + tasks",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/projects/1"
      }
    },
    {
      "name": "Tasks / List (filters)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/projects/1/tasks?status=todo&assignee=unassigned",
          "host": ["{{baseUrl}}"],
          "path": ["projects", "1", "tasks"],
          "query": [
            { "key": "status", "value": "todo" },
            { "key": "assignee", "value": "unassigned" }
          ]
        }
      }
    },
    {
      "name": "Tasks / Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"New task\",\n  \"description\": \"\",\n  \"priority\": \"medium\",\n  \"assignee_id\": null,\n  \"due_date\": null\n}"
        },
        "url": "{{baseUrl}}/projects/1/tasks"
      }
    },
    {
      "name": "Tasks / Patch",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"done\"\n}"
        },
        "url": "{{baseUrl}}/tasks/1"
      }
    },
    {
      "name": "Tasks / Delete",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/tasks/1"
      }
    }
  ]
}
